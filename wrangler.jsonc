{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinemaos",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinemaos-db",
      "database_id": "c252d3d8-7198-40ce-a913-2af144399b63"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "cinemaos-content"
    }
  ]
}
